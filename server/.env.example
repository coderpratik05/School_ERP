# PostgreSQL connection string (Neon / Supabase / Render / Railway / local)
DATABASE_URL=postgres://user:password@localhost:5432/school_erp
# Set to true for most hosted databases (Neon, Render, Supabase need SSL)
DATABASE_SSL=false

# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call this API, comma separated (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
